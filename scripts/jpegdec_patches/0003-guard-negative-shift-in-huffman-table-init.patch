From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patch <patch@local>
Date: Sun, 14 Sep 2026 00:00:00 -0700
Subject: [PATCH 3/3] Guard negative shift exponents in Huffman table init

JPEGMakeHuffTables / JPEGMakeHuffTables_Slow test "first N bits of the
code are all 1s" with `cc >> (iBitNum-N)`; for codes shorter than N
bits the exponent is negative, which is undefined behavior (UBSan:
shift exponent is negative, hit during table init on every decode).
A code of fewer than N bits cannot have N leading 1s, so the short
table branch is the intended result -- which is also what hardware
that masks the shift count (x86/ARM/RISC-V) happened to produce.
Guarding with `iBitNum >= N` removes the UB without changing behavior.

---
 src/jpeg.inl | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/jpeg.inl b/src/jpeg.inl
index 1bd38b2..e4c5398 100644
--- a/src/jpeg.inl
+++ b/src/jpeg.inl
@@ -923,7 +923,9 @@ static int JPEGMakeHuffTables_Slow(JPEGIMAGE *pJPEG, int bThumbnail)
                 while (iLen)
                 {
                     //               if (iBitNum > 6) // do long table
-                    if ((cc >> (iBitNum-5)) == 0x1f) // first 5 bits are 1 - use long table
+                    // CrossPoint patch: guard iBitNum < 5 (negative shift is UB; a code
+                    // shorter than 5 bits cannot have 5 leading 1s -> short table).
+                    if (iBitNum >= 5 && (cc >> (iBitNum-5)) == 0x1f) // first 5 bits are 1 - use long table
                     {
                         count = iMaxLength - iBitNum;
                         codestart = cc << count;
@@ -1011,7 +1013,9 @@ static int JPEGMakeHuffTables_Slow(JPEGIMAGE *pJPEG, int bThumbnail)
                 iLen = *pBits++; // get number of codes for this bit length
                 while (iLen)
                 {
-                    if ((cc >> (iBitNum-4)) == 0xf) // first 4 bits are 1 - use long table
+                    // CrossPoint patch: guard iBitNum < 4 (negative shift is UB; a code
+                    // shorter than 4 bits cannot have 4 leading 1s -> short table).
+                    if (iBitNum >= 4 && (cc >> (iBitNum-4)) == 0xf) // first 4 bits are 1 - use long table
                     {
                         count = 16 - iBitNum;
                         codestart = cc << count;
@@ -1112,7 +1116,9 @@ static int JPEGMakeHuffTables(JPEGIMAGE *pJPEG, int bThumbnail)
                 while (iLen)
                 {
                     //               if (iBitNum > 6) // do long table
-                    if ((cc >> (iBitNum-5)) == 0x1f) // first 5 bits are 1 - use long table
+                    // CrossPoint patch: guard iBitNum < 5 (negative shift is UB; a code
+                    // shorter than 5 bits cannot have 5 leading 1s -> short table).
+                    if (iBitNum >= 5 && (cc >> (iBitNum-5)) == 0x1f) // first 5 bits are 1 - use long table
                     {
                         count = iMaxLength - iBitNum;
                         codestart = cc << count;
@@ -1197,7 +1203,9 @@ static int JPEGMakeHuffTables(JPEGIMAGE *pJPEG, int bThumbnail)
                 iLen = *pBits++; // get number of codes for this bit length
                 while (iLen)
                 {
-                    if ((cc >> (iBitNum-6)) == 0x3f) // first 6 bits are 1 - use long table
+                    // CrossPoint patch: guard iBitNum < 6 (negative shift is UB; a code
+                    // shorter than 6 bits cannot have 6 leading 1s -> short table).
+                    if (iBitNum >= 6 && (cc >> (iBitNum-6)) == 0x3f) // first 6 bits are 1 - use long table
                     {
                         count = 16 - iBitNum;
                         codestart = cc << count;
